# =====================================
# Sarvam Tech Academy — Environment Variables
# =====================================

# --- Sarvam AI (required) ---
SARVAM_API_KEY=your_sarvam_api_key_here

# --- WhatsApp Cloud API (required for live WhatsApp) ---2+++++++++++h
# https://developers.facebook.com → WhatsApp → API Setup
WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# --- Webhook verification (required) ---
# Choose any secret string; must match what you enter in Meta webhook config
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token_here

# --- Admin API token (required for /leads and /whatsapp/send) ---
# Choose any secret string
ADMIN_TOKEN=your_admin_api_token_here

# --- WhatsApp API version (optional, defaults to v20.0) ---
WHATSAPP_API_VERSION=v20.0

# --- Timezone (optional) ---
BUSINESS_TIMEZONE=Asia/Kolkata

# --- Log level (optional, defaults to INFO) ---
# Set to WARNING or ERROR in production to reduce PII in logs
LOG_LEVEL=INFO

# --- WhatsApp webhook signature verification (optional) ---
# Your Meta App Secret — enables X-Hub-Signature-256 verification
# WHATSAPP_APP_SECRET=your_meta_app_secret_here
